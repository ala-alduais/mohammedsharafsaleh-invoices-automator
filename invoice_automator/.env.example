# Telegram bot configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Comma-separated list of Telegram user IDs allowed to use the bot
ALLOWED_TELEGRAM_USER_ID=123456789,987654321

# Groq API
GROQ_API_KEY=your_groq_api_key_here

# (GEMINI_API_KEY is no longer used - extraction now runs on Groq)

# Vision model used as the FALLBACK extractor (scanned PDFs / plain images,
# i.e. anything with no embedded text layer)
VISION_MODEL=qwen/qwen3.8-27b

# Text model (Groq) used to structure a PDF's embedded TEXT layer - the
# preferred extraction path (exact text, no OCR, no vision)
TEXT_MODEL=qwen/qwen3.8-27b

# Confirmation / decision parsing model
DECISION_MODEL=openai/gpt-oss-120b

# Tax rate used in the math sanity check (default 15%)
TAX_RATE=0.15

# Send the .xlsx as soon as the batch is processed (no confirmation step)
AUTO_SEND=true
